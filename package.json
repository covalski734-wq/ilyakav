{
  "name": "ilyakav",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir .ssg && node scripts/prerender.mjs",
    "preview": "wrangler dev",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-check.mjs && node scripts/visual-check.mjs",
    "cf:check": "wrangler deploy --dry-run",
    "pages:check": "wrangler pages functions build functions --outdir .wrangler/pages-check",
    "pages:preview": "npm run build && wrangler pages dev dist",
    "pages:deploy": "npm run build && wrangler pages deploy dist",
    "typecheck": "tsc -b --noEmit",
    "cf:preview": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "gsap": "^3.12.5",
    "i18next": "^23.16.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.2.0",
    "styled-components": "^6.1.13"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-plugin-styled-components": "^2.1.4",
    "playwright": "^1.62.1",
    "typescript": "^5.6.3",
    "vite": "^7.3.6",
    "wrangler": "^4.125.0"
  }
}
